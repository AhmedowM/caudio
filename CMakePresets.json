{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "inherits": "toolchain-auto"
    },
    {
      "name": "toolchain-gcc",
      "hidden": true,
      "displayName": "Compiler mixin: canonical GCC (only CI/Release compiler)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/gcc.cmake"
      }
    },
    {
      "name": "toolchain-clang",
      "hidden": true,
      "displayName": "Compiler mixin: Clang (local dev / perf comparison)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/clang.cmake"
      }
    },
    {
      "name": "toolchain-msvc",
      "hidden": true,
      "displayName": "Compiler mixin: MSVC (local dev only; needs VS generator or vcvars)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/msvc.cmake"
      }
    },
    {
      "name": "toolchain-auto",
      "hidden": true,
      "displayName": "Compiler mixin: host default (Linux GCC, macOS brew LLVM, Windows MSVC-if-usable else PATH)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/auto.cmake"
      }
    },
    {
      "name": "dev-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_ENABLE_EXAMPLES": "ON"
      }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_TEST_NOAUDIO": "ON"
      }
    },
    {
      "name": "modules-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CAUDIO_ENABLE_MODULES": "ON",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAUDIO_REQUIRE_GIT_VERSION": "ON"
      }
    },
    {
      "name": "release-lto-base",
      "hidden": true,
      "inherits": "release-base",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "minsize-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default: static libs + CLI, headers canonical"
    },
    {
      "name": "dev",
      "inherits": [
        "dev-base",
        "toolchain-auto"
      ],
      "displayName": "Local development: tests + examples"
    },
    {
      "name": "ci",
      "inherits": [
        "ci-base",
        "toolchain-auto"
      ],
      "displayName": "Headless CI: tests, no audio device"
    },
    {
      "name": "ci-sanitizers",
      "inherits": "ci",
      "displayName": "CI with ASan+UBSan (Linux GCC/Clang only)",
      "cacheVariables": {
        "CAUDIO_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "modules",
      "inherits": [
        "modules-base",
        "toolchain-auto"
      ],
      "displayName": "C++23 module smoke: modules on, no CLI/tests/examples"
    },
    {
      "name": "minimal",
      "inherits": "base",
      "displayName": "Library only: no CLI executable (no CLI11 fetch)",
      "cacheVariables": {
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "shared",
      "inherits": "base",
      "displayName": "Shared opt-in: *_shared variants + combined libcaudio, no CLI",
      "cacheVariables": {
        "CAUDIO_BUILD_SHARED": "ON",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": [
        "release-base",
        "toolchain-auto"
      ],
      "displayName": "Optimized release build"
    },
    {
      "name": "release-no-cli",
      "inherits": "release",
      "displayName": "Optimized release build (no CLI)",
      "cacheVariables": {
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "release-lto",
      "inherits": [
        "release-lto-base",
        "toolchain-auto"
      ],
      "displayName": "Release + link-time optimization"
    },
    {
      "name": "release-lto-no-cli",
      "inherits": "release",
      "displayName": "Release + link-time optimization (no CLI)",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "minsize",
      "inherits": [
        "minsize-base",
        "toolchain-auto"
      ],
      "displayName": "Smallest binary: MinSizeRel"
    },
    {
      "name": "minsize-no-cli",
      "inherits": "base",
      "displayName": "Smallest binary: MinSizeRel (no CLI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "minsize-lto",
      "inherits": "minsize",
      "displayName": "Smallest binary: MinSizeRel + LTO + section GC (GCC/Clang)",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_CXX_FLAGS": "-ffunction-sections -fdata-sections",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--gc-sections"
      }
    },
    {
      "name": "minsize-lto-no-cli",
      "inherits": "minsize-no-cli",
      "displayName": "Smallest binary: MinSizeRel + LTO + section GC, no CLI (GCC/Clang)",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_CXX_FLAGS": "-ffunction-sections -fdata-sections",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--gc-sections"
      }
    },
    {
      "name": "release-native",
      "inherits": "release-lto",
      "displayName": "Fastest local binary: -march=native. NOT distributable (illegal-instruction on older CPUs)",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-march=native"
      }
    },
    {
      "name": "release-native-no-cli",
      "inherits": "release-lto-no-cli",
      "displayName": "Fastest local binary, no CLI: -march=native. NOT distributable",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-march=native"
      }
    },
    {
      "name": "docs",
      "inherits": "base",
      "displayName": "Docs only: Doxygen build, no CLI/tests/examples",
      "cacheVariables": {
        "CAUDIO_BUILD_DOCS": "ON",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "all",
      "inherits": "base",
      "displayName": "Everything: tests, examples, docs, shared, modules, release (tag required)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAUDIO_REQUIRE_GIT_VERSION": "ON",
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_ENABLE_EXAMPLES": "ON",
        "CAUDIO_BUILD_DOCS": "ON",
        "CAUDIO_BUILD_SHARED": "ON",
        "CAUDIO_ENABLE_MODULES": "ON"
      }
    },
    {
      "name": "dev-clang",
      "inherits": [
        "toolchain-clang",
        "dev-base"
      ],
      "displayName": "Local development with Clang: tests + examples"
    },
    {
      "name": "dev-msvc",
      "inherits": [
        "toolchain-msvc",
        "dev-base"
      ],
      "displayName": "Local development with MSVC: tests + examples (VS 2026 generator)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "warnings": {
        "unusedCli": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "ci-clang",
      "inherits": [
        "toolchain-clang",
        "ci-base"
      ],
      "displayName": "Headless CI with Clang: tests, no audio device"
    },
    {
      "name": "ci-msvc",
      "inherits": [
        "toolchain-msvc",
        "ci-base"
      ],
      "displayName": "Headless CI with MSVC: tests, no audio device (VS 2026 generator)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "warnings": {
        "unusedCli": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "modules-clang",
      "inherits": [
        "toolchain-clang",
        "modules-base"
      ],
      "displayName": "C++23 module smoke with Clang: modules on, no CLI/tests/examples"
    },
    {
      "name": "modules-msvc",
      "inherits": [
        "toolchain-msvc",
        "modules-base"
      ],
      "displayName": "C++23 module smoke with MSVC: modules on, no CLI/tests/examples (VS 2026 generator)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "warnings": {
        "unusedCli": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "release-clang",
      "inherits": [
        "toolchain-clang",
        "release-base"
      ],
      "displayName": "Optimized release build with Clang"
    },
    {
      "name": "release-msvc",
      "inherits": [
        "toolchain-msvc",
        "release-base"
      ],
      "displayName": "Optimized release build with MSVC (VS 2026 generator)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "warnings": {
        "unusedCli": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "release-lto-clang",
      "inherits": [
        "toolchain-clang",
        "release-lto-base"
      ],
      "displayName": "Release + link-time optimization with Clang"
    },
    {
      "name": "release-lto-msvc",
      "inherits": [
        "toolchain-msvc",
        "release-lto-base"
      ],
      "displayName": "Release + link-time optimization with MSVC (VS 2026 generator)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "warnings": {
        "unusedCli": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "minsize-clang",
      "inherits": [
        "toolchain-clang",
        "minsize-base"
      ],
      "displayName": "Smallest binary with Clang: MinSizeRel"
    },
    {
      "name": "minsize-msvc",
      "inherits": [
        "toolchain-msvc",
        "minsize-base"
      ],
      "displayName": "Smallest binary with MSVC: MinSizeRel (VS 2026 generator)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "warnings": {
        "unusedCli": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "custom",
      "inherits": "base",
      "displayName": "Custom build dir via CAUDIO_BUILD_DIR env var (compiler from PATH)",
      "binaryDir": "$env{CAUDIO_BUILD_DIR}",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{CAUDIO_BUILD_DIR}",
        "rhs": ""
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": null
      }
    },
    {
      "name": "dev-gcc",
      "inherits": [
        "toolchain-gcc",
        "dev-base"
      ],
      "displayName": "Local development with GCC: tests + examples",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ci-gcc",
      "inherits": [
        "toolchain-gcc",
        "ci-base"
      ],
      "displayName": "Headless CI with GCC: tests, no audio device",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ci-trimmed",
      "inherits": [
        "toolchain-gcc",
        "ci-base"
      ],
      "displayName": "Trimmed FFmpeg CI: decode-only whitelist build, no audio device",
      "cacheVariables": {
        "CAUDIO_USE_TRIMMED_FFMPEG": "ON",
        "FFmpeg_ROOT": "$penv{CAUDIO_TRIMMED_ROOT}"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "modules-gcc",
      "inherits": [
        "toolchain-gcc",
        "modules-base"
      ],
      "displayName": "C++23 module smoke with GCC: modules on, no CLI/tests/examples",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "release-gcc",
      "inherits": [
        "toolchain-gcc",
        "release-base"
      ],
      "displayName": "Optimized release build with GCC",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "release-lto-gcc",
      "inherits": [
        "toolchain-gcc",
        "release-lto-base"
      ],
      "displayName": "Release + link-time optimization with GCC",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "minsize-gcc",
      "inherits": [
        "toolchain-gcc",
        "minsize-base"
      ],
      "displayName": "Smallest binary with GCC: MinSizeRel",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "minsize-lto-gcc",
      "inherits": [
        "toolchain-gcc",
        "minsize-lto"
      ],
      "displayName": "Smallest binary with GCC: MinSizeRel + LTO + section GC",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "minsize-lto-clang",
      "inherits": [
        "toolchain-clang",
        "minsize-lto"
      ],
      "displayName": "Smallest binary with Clang: MinSizeRel + LTO + section GC"
    },
    {
      "name": "minsize-lto-msvc",
      "inherits": [
        "toolchain-msvc",
        "minsize-base"
      ],
      "displayName": "Smallest binary with MSVC: MinSizeRel + LTO (VS 2026 generator)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "warnings": {
        "unusedCli": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_CXX_FLAGS": "/Gy"
      }
    }
  ],
