{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default: static libs + CLI, headers canonical"
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Local development: tests + examples",
      "cacheVariables": {
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_ENABLE_EXAMPLES": "ON"
      }
    },
    {
      "name": "ci",
      "inherits": "base",
      "displayName": "Headless CI: tests, no audio device",
      "cacheVariables": {
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_TEST_NOAUDIO": "ON"
      }
    },
    {
      "name": "ci-sanitizers",
      "inherits": "ci",
      "displayName": "CI with ASan+UBSan (Linux GCC/Clang only)",
      "cacheVariables": {
        "CAUDIO_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "modules",
      "inherits": "base",
      "displayName": "C++23 module smoke: modules on, tests/examples off",
      "cacheVariables": {
        "CAUDIO_ENABLE_MODULES": "ON"
      }
    },
    {
      "name": "minimal",
      "inherits": "base",
      "displayName": "Library only: no CLI executable (no CLI11 fetch)",
      "cacheVariables": {
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "shared",
      "inherits": "base",
      "displayName": "Shared opt-in: *_shared variants + combined libcaudio",
      "cacheVariables": {
        "CAUDIO_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Optimized release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 4
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 4
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "jobs": 4
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "jobs": 4
    },
    {
      "name": "modules",
      "configurePreset": "modules",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    }
  ]
}
