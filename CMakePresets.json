{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default: static libs + CLI, headers canonical"
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Local development: tests + examples",
      "cacheVariables": {
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_ENABLE_EXAMPLES": "ON"
      }
    },
    {
      "name": "ci",
      "inherits": "base",
      "displayName": "Headless CI: tests, no audio device",
      "cacheVariables": {
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_TEST_NOAUDIO": "ON"
      }
    },
    {
      "name": "ci-sanitizers",
      "inherits": "ci",
      "displayName": "CI with ASan+UBSan (Linux GCC/Clang only)",
      "cacheVariables": {
        "CAUDIO_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "modules",
      "inherits": "base",
      "displayName": "C++23 module smoke: modules on, no CLI/tests/examples",
      "cacheVariables": {
        "CAUDIO_ENABLE_MODULES": "ON",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "minimal",
      "inherits": "base",
      "displayName": "Library only: no CLI executable (no CLI11 fetch)",
      "cacheVariables": {
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "shared",
      "inherits": "base",
      "displayName": "Shared opt-in: *_shared variants + combined libcaudio, no CLI",
      "cacheVariables": {
        "CAUDIO_BUILD_SHARED": "ON",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Optimized release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAUDIO_REQUIRE_GIT_VERSION": "ON"
      }
    },
    {
      "name": "release-no-cli",
      "inherits": "release",
      "displayName": "Optimized release build (no CLI)",
      "cacheVariables": {
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "release-lto",
      "inherits": "release",
      "displayName": "Release + link-time optimization",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "release-lto-no-cli",
      "inherits": "release",
      "displayName": "Release + link-time optimization (no CLI)",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "minsize",
      "inherits": "base",
      "displayName": "Smallest binary: MinSizeRel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "minsize-no-cli",
      "inherits": "base",
      "displayName": "Smallest binary: MinSizeRel (no CLI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "minsize-lto",
      "inherits": "minsize",
      "displayName": "Smallest binary: MinSizeRel + LTO + section GC (GCC/Clang)",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_CXX_FLAGS": "-ffunction-sections -fdata-sections",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--gc-sections"
      }
    },
    {
      "name": "minsize-lto-no-cli",
      "inherits": "minsize-no-cli",
      "displayName": "Smallest binary: MinSizeRel + LTO + section GC, no CLI (GCC/Clang)",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_CXX_FLAGS": "-ffunction-sections -fdata-sections",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--gc-sections"
      }
    },
    {
      "name": "release-native",
      "inherits": "release-lto",
      "displayName": "Fastest local binary: -march=native. NOT distributable (illegal-instruction on older CPUs)",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-march=native"
      }
    },
    {
      "name": "release-native-no-cli",
      "inherits": "release-lto-no-cli",
      "displayName": "Fastest local binary, no CLI: -march=native. NOT distributable",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-march=native"
      }
    },
    {
      "name": "docs",
      "inherits": "base",
      "displayName": "Docs only: Doxygen build, no CLI/tests/examples",
      "cacheVariables": {
        "CAUDIO_BUILD_DOCS": "ON",
        "CAUDIO_BUILD_CLI": "OFF"
      }
    },
    {
      "name": "all",
      "inherits": "base",
      "displayName": "Everything: tests, examples, docs, shared, modules, release (tag required)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAUDIO_REQUIRE_GIT_VERSION": "ON",
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_ENABLE_EXAMPLES": "ON",
        "CAUDIO_BUILD_DOCS": "ON",
        "CAUDIO_BUILD_SHARED": "ON",
        "CAUDIO_ENABLE_MODULES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 4
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 4
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "jobs": 4
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "jobs": 4
    },
    {
      "name": "modules",
      "configurePreset": "modules",
      "jobs": 4
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": ["doc"]
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    },
    {
      "name": "release-no-cli",
      "configurePreset": "release-no-cli",
      "jobs": 4
    },
    {
      "name": "release-lto",
      "configurePreset": "release-lto",
      "jobs": 4
    },
    {
      "name": "release-lto-no-cli",
      "configurePreset": "release-lto-no-cli",
      "jobs": 4
    },
    {
      "name": "minsize",
      "configurePreset": "minsize",
      "jobs": 4
    },
    {
      "name": "minsize-no-cli",
      "configurePreset": "minsize-no-cli",
      "jobs": 4
    },
    {
      "name": "minsize-lto",
      "configurePreset": "minsize-lto",
      "jobs": 4
    },
    {
      "name": "minsize-lto-no-cli",
      "configurePreset": "minsize-lto-no-cli",
      "jobs": 4
    },
    {
      "name": "release-native",
      "configurePreset": "release-native",
      "jobs": 4
    },
    {
      "name": "release-native-no-cli",
      "configurePreset": "release-native-no-cli",
      "jobs": 4
    },
    {
      "name": "all",
      "configurePreset": "all",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    },
    {
      "name": "all",
      "configurePreset": "all",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4
      }
    }
  ]
}
