{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain.cmake",
        "CAUDIO_TOOLCHAIN": "auto"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Local development: Debug, tests + examples",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_ENABLE_EXAMPLES": "ON"
      }
    },
    {
      "name": "ci",
      "inherits": "base",
      "displayName": "Headless CI: Debug, tests, no audio device",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAUDIO_ENABLE_TESTS": "ON",
        "CAUDIO_TEST_NOAUDIO": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Optimized release build (tag required)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAUDIO_REQUIRE_GIT_VERSION": "ON"
      }
    },
    {
      "name": "release-lto",
      "inherits": "base",
      "displayName": "Release + link-time optimization (tag required)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CAUDIO_REQUIRE_GIT_VERSION": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "minsize",
      "inherits": "base",
      "displayName": "Smallest binary: MinSizeRel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    },
    {
      "name": "minsize-lto",
      "inherits": "base",
      "displayName": "Smallest binary: MinSizeRel + LTO + section GC",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CAUDIO_LINK_SECTION_GC": "ON"
      }
    },
    {
      "name": "modules",
      "inherits": "base",
      "displayName": "C++23 modules: modules on, no CLI/tests/examples",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CAUDIO_ENABLE_MODULES": "ON",
        "CAUDIO_BUILD_CLI": "OFF",
        "CAUDIO_ENABLE_TESTS": "OFF",
        "CAUDIO_ENABLE_EXAMPLES": "OFF"
      }
    },
    {
      "name": "android",
      "inherits": "base",
      "displayName": "Android NDK: shared library, arm64-v8a",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/android.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "CAUDIO_BUILD_CLI": "OFF",
        "CAUDIO_BUILD_STATIC": "OFF",
        "CAUDIO_BUILD_SHARED": "ON",
        "CAUDIO_ENABLE_TESTS": "OFF",
        "CAUDIO_ENABLE_EXAMPLES": "OFF",
        "CAUDIO_ENABLE_MODULES": "OFF",
        "CAUDIO_BUILD_DOCS": "OFF",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-lto",
      "configurePreset": "release-lto"
    },
    {
      "name": "minsize",
      "configurePreset": "minsize"
    },
    {
      "name": "minsize-lto",
      "configurePreset": "minsize-lto"
    },
    {
      "name": "modules",
      "configurePreset": "modules"
    },
    {
      "name": "android",
      "configurePreset": "android"
    }
  ]
}
