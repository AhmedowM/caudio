/**
 * @file version.h
 * @brief Version information for cstdx. Generated by CMake from version.h.in.
 */
#ifndef CSTDX_VERSION_H
#define CSTDX_VERSION_H

/** Full version string, including any pre-release suffix. */
#define CSTDX_VERSION "@CSTDX_VERSION_FULL@"

/** Short git hash of the source tree, or "unknown". */
#define CSTDX_GIT_HASH "@CSTDX_GIT_HASH@"

#define CSTDX_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CSTDX_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CSTDX_VERSION_PATCH @PROJECT_VERSION_PATCH@

#endif /* CSTDX_VERSION_H */
