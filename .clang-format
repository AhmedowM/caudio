# .clang-format for caudio — C23 (ISO/IEC 9899:2024)
#
# Mirrors kanariv's clang-format style but targets the C language
# instead of C++. C23 keywords (nullptr, bool, constexpr, thread_local,
# typeof, static_assert) are native; clang-format handles them as tokens,
# so no C++-specific constructs (references, templates, static_cast) apply.

BasedOnStyle: LLVM
Language: C
Standard: Latest
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
InsertNewlineAtEOF: true
IndentCaseLabels: false
KeepEmptyLinesAtTheStartOfBlocks: false
AllowShortFunctionsOnASingleLine:
  Empty: true
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AlignAfterOpenBracket: true
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignOperands: Align
AlignTrailingComments: true
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<.*>'
    Priority: 2
  - Regex: '^".*"'
    Priority: 3
SortUsingDeclarations: true
FixNamespaceComments: true
ReflowComments: true
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpacesInAngles: false
Cpp11BracedListStyle: true
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: true
BinPackParameters: true
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyReturnTypeOnItsOwnLine: 60
