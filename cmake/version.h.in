/**
 * @file version.h
 * @brief Version information for the caudio library. Generated by CMake from version.h.in.
 */
#ifndef CAUDIO_VERSION_H
#define CAUDIO_VERSION_H

/** Full version string, including any pre-release suffix. */
#define CAUDIO_VERSION "@CAUDIO_VERSION_FULL@"

/** Short git hash of the source tree, or "unknown". */
#define CAUDIO_GIT_HASH "@CAUDIO_GIT_HASH@"

#define CAUDIO_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CAUDIO_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CAUDIO_VERSION_PATCH @PROJECT_VERSION_PATCH@

#endif /* CAUDIO_VERSION_H */
